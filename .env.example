# Mock is safe, deterministic, and uses no model API or Codex allowance.
HERMES_EXECUTION_MODE=mock

AI_ORG_PORT=4318
AI_ORG_DATA_DIR=.data
AI_ORG_MAX_CONCURRENCY=2
AI_ORG_EXECUTION_TIMEOUT_MS=1800000
HERMES_POLL_INTERVAL_MS=500

# Live pilot: prefer one dedicated loopback Runs API per profile.
# Never commit real keys. Start with only the profiles used by the pilot.
# HERMES_PROFILE_ENDPOINTS_JSON={"ceo":{"baseUrl":"http://127.0.0.1:8701","apiKey":"replace-me"}}

# Experimental only: the pinned Hermes version has not verified profile-prefixed Runs routes.
# HERMES_MULTIPLEX_BASE_URL=http://127.0.0.1:8642
# HERMES_MULTIPLEX_API_KEY=replace-me
