# Mock is safe, deterministic, and uses no model API or Codex allowance.
HERMES_EXECUTION_MODE=mock

AI_ORG_PORT=4318
AI_ORG_DATA_DIR=.data
AI_ORG_MAX_CONCURRENCY=2
AI_ORG_EXECUTION_TIMEOUT_MS=1800000
HERMES_POLL_INTERVAL_MS=500

# Live pilot: prefer one dedicated loopback Runs API per profile.
# Never commit real keys. Start with only the profiles used by the pilot.
# HERMES_PROFILE_ENDPOINTS_JSON={"ceo":{"baseUrl":"http://127.0.0.1:8701","apiKey":"replace-me"}}

# Experimental only: the pinned Hermes version has not verified profile-prefixed Runs routes.
# HERMES_MULTIPLEX_BASE_URL=http://127.0.0.1:8642
# HERMES_MULTIPLEX_API_KEY=replace-me

# Phase 1 VMware Fusion lifecycle is disabled unless all four target values are set.
# The VMX path must be the exact target recorded on one current Studio instance.
# Do not configure a personal/important VM for the lifecycle smoke.
# A complete target is read-only by default. Set ACTIONS_ARMED=true only with
# an ISO-8601 deadline no more than 30 minutes in the future, for the explicitly
# approved smoke window. Then remove both action values or return to false.
# VMWARE_FUSION_VMRUN_PATH=/Applications/VMware Fusion.app/Contents/Library/vmrun
# VMWARE_FUSION_STUDIO_ID=studio-github-research
# VMWARE_FUSION_INSTANCE_ID=replace-with-disposable-instance-id
# VMWARE_FUSION_VMX_PATH=/absolute/path/to/Disposable Studio.vmwarevm/Disposable Studio.vmx
# VMWARE_FUSION_ACTIONS_ARMED=false
# VMWARE_FUSION_ACTIONS_ARMED_UNTIL=2026-07-31T13:15:00.000Z
